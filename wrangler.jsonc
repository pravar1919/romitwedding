{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "romit-ayushi-wedding",
  "compatibility_date": "2026-10-01",
  // `next build` exports the site to ./out, served as Workers static assets.
  // worker/index.js only runs for the visit counter (/api/hit) and the private /stats page.
  "main": "worker/index.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/stats"]
  },
  // per-IP limit on the visit counter (/api/hit): 30 requests a minute is far more than one guest makes
  "ratelimits": [
    { "name": "HIT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "romit-ayushi-stats", "database_id": "348473d5-2ead-4b8e-a555-28d4ee25a315" }
  ],
  // Keep `siteUrl` in lib/config.ts in sync with the main domain (used for WhatsApp link previews).
  // keep the original *.workers.dev link alive — it has already been shared
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "romitayushi.in", "custom_domain": true },
    { "pattern": "www.romitayushi.in", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
